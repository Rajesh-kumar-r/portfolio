---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="container">
    <Header />
    <main id="main">
      <article class="prose">
        <h1>{entry.data.title}</h1>
        <p class="prose__meta">{fmt(entry.data.date)}</p>
        <Content />
      </article>
      <p><a href="/">← back</a></p>
    </main>
    <Footer />
  </div>
</Base>

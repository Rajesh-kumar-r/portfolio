---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (
  await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Writing">
  <div class="container">
    <Header />
    <main id="main">
      <h1>Writing</h1>
      {
        posts.length === 0 ? (
          <p class="writing-empty">nothing published yet. when there is, it lands here.</p>
        ) : (
          <ul class="writing-list">
            {posts.map((post) => (
              <li>
                <a href={`/writing/${post.id}/`}>
                  <span class="writing-list__title">{post.data.title}</span>
                  <span class="writing-list__date">{fmt(post.data.date)}</span>
                  <span class="writing-list__desc">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
    <Footer />
  </div>
</Base>

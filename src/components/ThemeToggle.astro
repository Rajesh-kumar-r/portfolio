---
// Two-cell switch: sun | moon, with a sliding accent thumb over the active half.
// Dark is the default (attribute absent) → thumb sits on the moon.
---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch colour theme"
  aria-pressed="false"
  title="Switch colour theme"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__thumb"></span>
    <svg class="i-sun" width="13" height="13" viewBox="0 0 256 256"><path fill="currentColor" d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34L52.34,41A8,8,0,0,0,41,52.34Zm0,116.68L41,203.66A8,8,0,0,0,52.34,215l17.32-17.34a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34L215,52.34A8,8,0,0,0,203.66,41L186.34,58.34A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32L203.66,215A8,8,0,0,0,215,203.66ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"/></svg>
    <svg class="i-moon" width="13" height="13" viewBox="0 0 256 256"><path fill="currentColor" d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"/></svg>
  </span>
</button>
<script is:inline>
  (() => {
    const b = document.getElementById('theme-toggle');
    if (!b) return;
    const sync = () => {
      b.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'light'));
    };
    b.addEventListener('click', () => {
      const light = document.documentElement.dataset.theme === 'light';
      if (light) { delete document.documentElement.dataset.theme; }
      else { document.documentElement.dataset.theme = 'light'; }
      try { localStorage.setItem('theme', light ? 'dark' : 'light'); } catch (e) {}
      sync();
    });
    sync();
  })();
</script>
<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    line-height: 0;
  }

  .theme-toggle__track {
    position: relative;
    display: inline-grid;
    grid-template-columns: 26px 26px;
    align-items: center;
    justify-items: center;
    height: 24px;
    border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 24px;
    height: 18px;
    border-radius: calc(var(--radius-sm) - 3px);
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    box-shadow: inset 0 0 0 1px var(--accent-line);
    transform: translateX(24px);
  }

  .theme-toggle[aria-pressed="true"] .theme-toggle__thumb {
    transform: translateX(0);
  }

  .theme-toggle svg {
    position: relative;
    color: var(--color-neutral-700);
  }

  /* active glyph = the one under the thumb */
  .theme-toggle .i-moon { color: var(--accent-text); }
  .theme-toggle[aria-pressed="true"] .i-moon { color: var(--color-neutral-700); }
  .theme-toggle[aria-pressed="true"] .i-sun { color: var(--accent-text); }

  .theme-toggle:hover .theme-toggle__track { border-color: var(--accent-line); }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* the global "boop" lift in portfolio.css reads cheap on a switch */
  .theme-toggle:hover { transform: none; }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle__thumb,
    .theme-toggle svg {
      transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1), color 0.18s ease;
    }
  }
</style>
